# Copy to .env in the repository root. Never commit real credentials.
APP_NAME=DDL Radar API
DB_HOST=127.0.0.1
DB_PORT=3306
# Reserved project database name. This application does NOT create it.
DB_NAME=ddl_radar
# Use a dedicated database account when available.
DB_USER=
DB_PASSWORD=

# Notification text is sent to this model provider when parsing.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
